{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Web: Build and Run Project 530",
            "dependsOrder": "sequence",
            "dependsOn": [
                "Web: Build WASM (Emscripten)",
                "Web: Run Project 530 (Local Disk)"
            ],
            "group": "build",
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            }
        },
        {
            "label": "Web: Build WASM (Emscripten)",
            "type": "shell",
            "command": "powershell.exe",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}/scripts/dev_web.ps1",
                "build"
            ],
            "group": "build",
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            }
        },
        {
            "label": "Web: Run Project 530 (Local Disk)",
            "type": "shell",
            "isBackground": true,
            "command": "powershell.exe",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}/scripts/dev_web.ps1",
                "run",
                "-SearchRoot",
                "C:/lxzsrc/ParaEngine/ParaWorld/",
                "-SearchPath",
                "script/",
                "-ProjectId",
                "530"
            ],
            "problemMatcher": {
                "pattern": {
                    "regexp": "^(ERROR|Error):\\s+(.*)$",
                    "severity": 1,
                    "message": 2
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "^\\[dev_web\\.ps1\\]",
                    "endsPattern": "^(Serving WebParacraft shell from:|\\[dev_web\\.ps1\\] Server already running)"
                }
            },
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            }
        },
        {
            "label": "Web: Serve (Local Disk)",
            "type": "shell",
            "isBackground": true,
            "command": "powershell.exe",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}/scripts/dev_web.ps1",
                "serve",
                "-SearchRoot",
                "C:/lxzsrc/ParaEngine/ParaWorld/",
                "-SearchPath",
                "script/",
                "-ProjectId",
                "530"
            ],
            "problemMatcher": {
                "pattern": {
                    "regexp": "^(ERROR|Error):\\s+(.*)$",
                    "severity": 1,
                    "message": 2
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "^\\[dev_web\\.ps1\\]",
                    "endsPattern": "^(Serving WebParacraft shell from:|\\[dev_web\\.ps1\\] Server already running)"
                }
            },
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            }
        },
        {
            "label": "Web: Configure WASM (Emscripten)",
            "type": "shell",
            "command": "powershell.exe",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}/scripts/dev_web.ps1",
                "configure"
            ],
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            }
        },
        {
            "label": "Build ParaEngineClient (Debug)",
            "type": "shell",
            "command": "msbuild",
            "args": [
                "${workspaceFolder}\\bin\\ClientOpenGLx64\\ClientOpenGLx64.sln",
                "/p:Configuration=Debug",
                "/p:Platform=x64",
                "/m",
                "/v:minimal"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": "$msCompile",
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "options": {
                "shell": {
                    "executable": "cmd.exe",
                    "args": [
                        "/c",
                        "\"C:\\Program Files\\Microsoft Visual Studio\\2022\\Community\\Common7\\Tools\\VsDevCmd.bat\" && "
                    ]
                }
            }
        },
        {
            "label": "Build ParaEngineClient (Release)",
            "type": "shell",
            "command": "msbuild",
            "args": [
                "${workspaceFolder}\\bin\\ClientOpenGLx64\\ClientOpenGLx64.sln",
                "/p:Configuration=Release",
                "/p:Platform=x64",
                "/m",
                "/v:minimal"
            ],
            "group": "build",
            "problemMatcher": "$msCompile",
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "options": {
                "shell": {
                    "executable": "cmd.exe",
                    "args": [
                        "/c",
                        "\"C:\\Program Files\\Microsoft Visual Studio\\2022\\Community\\Common7\\Tools\\VsDevCmd.bat\" && "
                    ]
                }
            }
        },
        {
            "label": "Clean",
            "type": "shell",
            "command": "msbuild",
            "args": [
                "${workspaceFolder}\\bin\\ClientOpenGLx64\\ClientOpenGLx64.sln",
                "/t:Clean",
                "/p:Configuration=Debug",
                "/p:Platform=x64"
            ],
            "problemMatcher": "$msCompile",
            "options": {
                "shell": {
                    "executable": "cmd.exe",
                    "args": [
                        "/c",
                        "\"C:\\Program Files\\Microsoft Visual Studio\\2022\\Community\\Common7\\Tools\\VsDevCmd.bat\" && "
                    ]
                }
            }
        },
        {
            "label": "Rebuild ParaEngineClient (Debug)",
            "type": "shell",
            "command": "msbuild",
            "args": [
                "${workspaceFolder}\\bin\\ClientOpenGLx64\\ClientOpenGLx64.sln",
                "/t:Rebuild",
                "/p:Configuration=Debug",
                "/p:Platform=x64",
                "/m",
                "/v:minimal"
            ],
            "group": "build",
            "problemMatcher": "$msCompile",
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "options": {
                "shell": {
                    "executable": "cmd.exe",
                    "args": [
                        "/c",
                        "\"C:\\Program Files\\Microsoft Visual Studio\\2022\\Community\\Common7\\Tools\\VsDevCmd.bat\" && "
                    ]
                }
            }
        }
    ]
}
