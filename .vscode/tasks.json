{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Web: Build and Run Project 530",
            "dependsOrder": "sequence",
            "dependsOn": [
                "Web: Build WASM (Emscripten)",
                "Web: Run Project 530 (Local Disk)"
            ],
            "group": "build",
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            }
        },
        {
            "label": "Web: Build WASM (Emscripten)",
            "type": "shell",
            "command": "powershell.exe",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}/scripts/dev_web.ps1",
                "build"
            ],
            "group": "build",
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            }
        },
        {
            "label": "Web: Run Project 530 (Local Disk)",
            "type": "shell",
            "isBackground": true,
            "command": "powershell.exe",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}/scripts/dev_web.ps1",
                "run",
                "-SearchRoot",
                "C:/lxzsrc/ParaEngine/ParaWorld/",
                "-SearchPath",
                "script/",
                "-ProjectId",
                "530"
            ],
            "problemMatcher": {
                "pattern": {
                    "regexp": "^(ERROR|Error):\\s+(.*)$",
                    "severity": 1,
                    "message": 2
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "^\\[dev_web\\.ps1\\]",
                    "endsPattern": "^(Serving WebParacraft shell from:|\\[dev_web\\.ps1\\] Server already running)"
                }
            },
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            }
        },
        {
            "label": "Web: Serve (Local Disk)",
            "type": "shell",
            "isBackground": true,
            "command": "powershell.exe",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}/scripts/dev_web.ps1",
                "serve",
                "-SearchRoot",
                "C:/lxzsrc/ParaEngine/ParaWorld/",
                "-SearchPath",
                "script/",
                "-ProjectId",
                "530"
            ],
            "problemMatcher": {
                "pattern": {
                    "regexp": "^(ERROR|Error):\\s+(.*)$",
                    "severity": 1,
                    "message": 2
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "^\\[dev_web\\.ps1\\]",
                    "endsPattern": "^(Serving WebParacraft shell from:|\\[dev_web\\.ps1\\] Server already running)"
                }
            },
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            }
        },
        {
            "label": "Web: Configure WASM (Emscripten)",
            "type": "shell",
            "command": "powershell.exe",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}/scripts/dev_web.ps1",
                "configure"
            ],
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            }
        },
        {
            "label": "Mac: Build and Run Project 530",
            "dependsOrder": "sequence",
            "dependsOn": [
                "Mac: Build Paracraft",
                "Mac: Run Project 530"
            ],
            "group": "build",
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            }
        },
        {
            "label": "Mac: Build Paracraft",
            "type": "shell",
            "command": "${workspaceFolder}/build_linux.sh",
            "args": [
                "client"
            ],
            "group": "build",
            "problemMatcher": "$gcc",
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            }
        },
        {
            "label": "Mac: Run Project 530",
            "type": "shell",
            "command": "${workspaceFolder}/build_linux.sh",
            "args": [
                "run",
                "auto",
                "530"
            ],
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            }
        },
        {
            "label": "Mac: Configure Paracraft (CMake)",
            "type": "shell",
            "command": "${workspaceFolder}/build_linux.sh",
            "args": [
                "client",
                "--configure"
            ],
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            }
        },
        {
            "label": "Build ParaEngineClient (Debug)",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build",
                "${workspaceFolder}/build-win64",
                "--config",
                "Debug",
                "--parallel",
                "--",
                "/v:minimal"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": "$msCompile",
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            }
        },
        {
            "label": "Build ParaEngineClient (Release)",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build",
                "${workspaceFolder}/build-win64",
                "--config",
                "Release",
                "--parallel",
                "--",
                "/v:minimal"
            ],
            "group": "build",
            "problemMatcher": "$msCompile",
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            }
        },
        {
            "label": "Rebuild ParaEngineClient (Debug)",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build",
                "${workspaceFolder}/build-win64",
                "--config",
                "Debug",
                "--clean-first",
                "--parallel",
                "--",
                "/v:minimal"
            ],
            "group": "build",
            "problemMatcher": "$msCompile",
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            }
        },
        {
            "label": "Rebuild ParaEngineClient (Release)",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build",
                "${workspaceFolder}/build-win64",
                "--config",
                "Release",
                "--clean-first",
                "--parallel",
                "--",
                "/v:minimal"
            ],
            "group": "build",
            "problemMatcher": "$msCompile",
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            }
        },
        {
            "label": "Clean ParaEngineClient",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build",
                "${workspaceFolder}/build-win64",
                "--target",
                "clean",
                "--config",
                "Debug"
            ],
            "problemMatcher": "$msCompile",
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            }
        },
        {
            "label": "Windows: Configure ParaEngineClient (CMake)",
            "type": "shell",
            "command": "powershell.exe",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-Command",
                "$boost = if ($env:BOOST_ROOT -and (Test-Path $env:BOOST_ROOT)) { $env:BOOST_ROOT } elseif (Test-Path 'C:/lxzsrc/externals/boost_1_90_0') { 'C:/lxzsrc/externals/boost_1_90_0' } elseif (Test-Path 'C:/local/boost_1_85_0') { 'C:/local/boost_1_85_0' } else { 'C:/Boost' }; cmake -S '${workspaceFolder}/NPLRuntime' -B '${workspaceFolder}/build-win64' -A x64 -DBOOST_ROOT=\"$boost\" -DNPLRUNTIME_RENDERER=OPENGL -DNPLRUNTIME_ENABLE_ROBOTICS=ON"
            ],
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            }
        },
        {
            "label": "Build ParaEngineServer (Release)",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build",
                "${workspaceFolder}/build-server",
                "--config",
                "Release",
                "--parallel",
                "--",
                "/v:minimal"
            ],
            "group": "build",
            "problemMatcher": "$msCompile",
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            }
        },
        {
            "label": "Windows: Configure ParaEngineServer (CMake)",
            "type": "shell",
            "command": "powershell.exe",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-Command",
                "$boost = if ($env:BOOST_ROOT -and (Test-Path $env:BOOST_ROOT)) { $env:BOOST_ROOT } elseif (Test-Path 'C:/lxzsrc/externals/boost_1_90_0') { 'C:/lxzsrc/externals/boost_1_90_0' } elseif (Test-Path 'C:/local/boost_1_85_0') { 'C:/local/boost_1_85_0' } else { 'C:/Boost' }; cmake -S '${workspaceFolder}/NPLRuntime' -B '${workspaceFolder}/build-server' -A x64 -DBOOST_ROOT=\"$boost\" -DNPLRUNTIME_SERVER=ON"
            ],
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            }
        }
    ]
}
