{
    "version": "0.2.0",
    "configurations": [

        {
            "name": "Debug ParaEngineClient",
            "type": "cppvsdbg",
            "request": "launch",
            "program": "${workspaceFolder}/bin/ClientOpenGLx64/bin/ParaEngineClient_d.exe",
            "args": ["debug=true", "single=false", "mc=true", "world=worlds/DesignHouse/_user/lixizhi/TestLiveModel"],
            "stopAtEntry": false,
            "cwd": "C:\\lxzsrc\\ParaEngine\\ParaWorld\\",
            "environment": [],
            "preLaunchTask": "Build ParaEngineClient (Debug)"
        },
        {
            "name": "Debug ParaEngineClient (No Build)",
            "type": "cppvsdbg",
            "request": "launch",
            "program": "${workspaceFolder}/bin/ClientOpenGLx64/bin/ParaEngineClient_d.exe",
            "args": ["debug=true", "single=false", "mc=true", "world=worlds/DesignHouse/_user/lixizhi/TestLiveModel"],
            "stopAtEntry": false,
            "cwd": "C:\\lxzsrc\\ParaEngine\\ParaWorld\\",
            "environment": []
        },
        {
            "name": "Release ParaEngineClient",
            "type": "cppvsdbg",
            "request": "launch",
            "program": "${workspaceFolder}/bin/ClientOpenGLx64/bin/ParaEngineClient.exe",
            "args": ["debug=true", "single=false", "mc=true", "world=worlds/DesignHouse/_user/lixizhi/TestLiveModel"],
            "stopAtEntry": false,
            "cwd": "C:\\lxzsrc\\ParaEngine\\ParaWorld\\",
            "environment": [],
            "preLaunchTask": "Build ParaEngineClient (Release)"
        },
        {
            "name": "Attach to Process",
            "type": "cppvsdbg",
            "request": "attach",
            "processId": "${command:pickProcess}"
        },
        {
            "name": "Emscripten: Launch in Browser (Single Thread)",
            "type": "chrome",
            "request": "launch",
            "url": "http://localhost:8080/ParaCraft.html",
            "webRoot": "${workspaceFolder}",
            "preLaunchTask": "Emscripten: Serve (Single Thread)",
            "serverReadyAction": {
                "pattern": "Serving .* at http://localhost:([0-9]+)",
                "uriFormat": "http://localhost:%s/ParaCraft.html",
                "action": "openExternally"
            }
        },
        {
            "name": "Emscripten: Rebuild & Launch (Single Thread)",
            "type": "chrome",
            "request": "launch",
            "url": "http://localhost:8080/ParaCraft.html",
            "webRoot": "${workspaceFolder}",
            "preLaunchTask": "Emscripten: Serve (Rebuild & Single Thread)",
            "serverReadyAction": {
                "pattern": "Serving .* at http://localhost:([0-9]+)",
                "uriFormat": "http://localhost:%s/ParaCraft.html",
                "action": "openExternally"
            }
        }
    ]
}
