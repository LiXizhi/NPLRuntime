# Included by the simulator smoke build. The external targets exist after
# the top-level project has finished adding its subdirectories.
if(CMAKE_CURRENT_SOURCE_DIR STREQUAL CMAKE_SOURCE_DIR AND PROJECT_NAME STREQUAL "NPLRuntime")
    include_guard(GLOBAL)
    function(use_simulator_libraries)
        foreach(archive luajit jpeg curl ssl crypto)
            if(NOT EXISTS "${SIMULATOR_PREFIX}/lib/lib${archive}.a")
                message(FATAL_ERROR "Missing ${SIMULATOR_PREFIX}/lib/lib${archive}.a (see docs/mobile-dependencies.md)")
            endif()
        endforeach()
        set_property(TARGET luajit21 PROPERTY INTERFACE_LINK_LIBRARIES "${SIMULATOR_PREFIX}/lib/libluajit.a")
        set_property(TARGET libjpeg PROPERTY INTERFACE_LINK_LIBRARIES "${SIMULATOR_PREFIX}/lib/libjpeg.a")
        set_property(TARGET libcurl PROPERTY INTERFACE_LINK_LIBRARIES "${SIMULATOR_PREFIX}/lib/libcurl.a;para_libssl;para_libcrypto;-lz")
        foreach(component ssl crypto)
            set_property(TARGET para_lib${component} PROPERTY INTERFACE_LINK_LIBRARIES "${SIMULATOR_PREFIX}/lib/lib${component}.a")
            set_property(TARGET para_lib${component} PROPERTY INTERFACE_INCLUDE_DIRECTORIES "${SIMULATOR_PREFIX}/include")
        endforeach()
    endfunction()
    cmake_language(DEFER CALL use_simulator_libraries)
endif()
